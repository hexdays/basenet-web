---
interface Props {
  label: string;
  id: string;
  active?: boolean;
  items: { label: string; href: string }[];
}
const { label, id, active = false, items } = Astro.props;
---

<div class="relative" data-nav-dropdown>
  <button
    type="button"
    aria-expanded="false"
    aria-controls={id}
    class:list={[
      'flex items-center gap-1.5 border-b-2 border-transparent py-3 text-nav transition-colors hover:text-accent focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none',
      active && 'border-accent font-semibold text-accent',
    ]}
  >
    {label}
    <svg class="size-4 transition-transform motion-reduce:transition-none [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
  <ul id={id} hidden class="absolute right-0 z-20 mt-3 min-w-48 rounded-md bg-white py-2 text-lg font-medium shadow-lg ring-1 ring-brand-100">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class="block px-4 py-2 text-brand-900 hover:bg-brand-50 focus-visible:bg-brand-50 focus-visible:outline-3 focus-visible:-outline-offset-3 focus-visible:outline-brand-900"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');

  dropdowns.forEach((root) => {
    const button = root.querySelector('button')!;
    const panel = root.querySelector<HTMLElement>('ul')!;

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    button.addEventListener('click', () => setOpen(panel.hidden));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });

    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
  });
</script>
