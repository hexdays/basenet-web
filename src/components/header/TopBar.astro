---
import TopBarItem from './TopBarItem.astro';
import { COMPANY } from '../../site.config';

const iconClass = 'size-5 shrink-0';
---

<div class="border-b border-brand-100 bg-white">
  <div class="mx-auto flex flex-col lg:flex-row max-w-7xl flex-wrap lg:items-center justify-between gap-x-6 gap-y-1 px-8 py-4">
    <div class="flex flex-wrap flex-row items-center justify-between gap-y-1 lg:gap-x-10">
      <TopBarItem href={COMPANY.phone.href}>
        <svg slot="icon" class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        {COMPANY.phone.display}
      </TopBarItem>
      <TopBarItem href={`mailto:${COMPANY.email}`}>
        <svg slot="icon" class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        {COMPANY.email}
      </TopBarItem>
    </div>
    <TopBarItem class="place-self-center">
      <svg slot="icon" class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      {COMPANY.operatingHours}
    </TopBarItem>
  </div>
</div>
