---
import NavDropdown from './NavDropdown.astro';

type NavItem = { label: string; href: string; children?: { label: string; href: string }[] };

const links: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Our Solution', href: '/solution' },
  { label: 'Brands', href: '/brands' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'News', href: '/news' },
  {
    label: 'Staff',
    href: '/staff',
    children: [
      { label: 'LMS', href: '/staff/lms' },
      { label: 'HRMS', href: '/staff/hrms' },
      { label: 'E-Car', href: '/staff/e-car' },
      { label: 'Webmail', href: '/staff/webmail' },
      { label: 'Cloud Data', href: '/staff/cloud-data' },
      { label: 'Staff Directory', href: '/staff/directory' },
    ],
  },
  { label: 'Training', href: '/training' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = path.startsWith(base) ? path.slice(base.length) || '/' : path;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
---

<nav aria-label="Main">
  <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 text-base font-medium lg:text-xl xl:text-2xl">
    {
      links.map(({ label, href, children }) => (
        <li>
          {children ? (
            <NavDropdown
              {label}
              id={`nav-${label.toLowerCase()}`}
              active={isActive(href)}
              items={children.map((c) => ({ ...c, href: withBase(c.href) }))}
            />
          ) : (
            <a
              href={withBase(href)}
              aria-current={isActive(href) ? 'page' : undefined}
              class="block border-b-2 border-transparent py-3 text-nav transition-colors hover:text-accent aria-[current=page]:border-accent aria-[current=page]:font-semibold aria-[current=page]:text-accent motion-reduce:transition-none"
            >
              {label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
