---
import NavDropdown from './NavDropdown.astro';

type NavItem = { label: string; href: string; children?: { label: string; href: string }[] };

const links: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Our Solution', href: '/solution' },
  { label: 'Brands', href: '/brands' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'News', href: '/news' },
  {
    label: 'Staff',
    href: '/staff',
    children: [
      { label: 'LMS', href: '/staff/lms' },
      { label: 'HRMS', href: '/staff/hrms' },
      { label: 'E-Car', href: '/staff/e-car' },
      { label: 'Webmail', href: '/staff/webmail' },
      { label: 'Cloud Data', href: '/staff/cloud-data' },
      { label: 'Staff Directory', href: '/staff/directory' },
    ],
  },
  { label: 'Training', href: '/training' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<nav aria-label="Main">
  <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-lg font-medium">
    {
      links.map(({ label, href, children }) => (
        <li>
          {children ? (
            <NavDropdown {label} id={`nav-${label.toLowerCase()}`} active={isActive(href)} items={children} />
          ) : (
            <a
              {href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="text-white transition-colors hover:text-sky-400 aria-[current=page]:text-sky-400 aria-[current=page]:underline underline-offset-4"
            >
              {label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
