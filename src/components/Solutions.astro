---
import Network from '@lucide/astro/icons/network';
import Server from '@lucide/astro/icons/server';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Cable from '@lucide/astro/icons/cable';
import Waypoints from '@lucide/astro/icons/waypoints';
import Zap from '@lucide/astro/icons/zap';
import Headset from '@lucide/astro/icons/headset';
import Blocks from '@lucide/astro/icons/blocks';
import SolutionCard from './SolutionCard.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = 'Our Solutions',
  title = 'The right foundation for your business.',
  description = 'Practical technology solutions that bring your infrastructure, operations and security together.',
} = Astro.props;

const solutions = [
  {
    icon: Network,
    title: 'Enterprise Networking',
    description: 'Keep your teams connected with secure, scalable networks designed for everyday performance.',
    capabilities: ['Switching', 'Wireless', 'Connectivity'],
  },
  {
    icon: Server,
    title: 'Server Virtualization',
    description: 'Make more of your infrastructure with flexible virtual environments that simplify IT operations.',
    capabilities: ['Servers', 'Virtualization', 'Storage'],
  },
  {
    icon: ShieldCheck,
    title: 'Surveillance & Access Control',
    description: 'Protect your premises and manage access with integrated systems that keep you in control.',
    capabilities: ['Video surveillance', 'Access management'],
  },
  {
    icon: Cable,
    title: 'Structured Cabling Solution',
    description: 'Build reliable copper and fiber pathways that support voice, data, and building systems.',
    capabilities: ['Copper', 'Fiber', 'Patching', 'Testing'],
  },
  {
    icon: Waypoints,
    title: 'Fiber Cabling Solution',
    description: 'Deploy high-speed fiber infrastructure for backbone connectivity and long-distance links.',
    capabilities: ['Fiber', 'Splicing', 'Termination', 'Testing'],
  },
  {
    icon: Zap,
    title: 'Electrical Cabling',
    description: 'Install power and electrical pathways that support devices, equipment, and building systems.',
    capabilities: ['Power', 'Distribution', 'Outlets', 'Grounding'],
  },
  {
    icon: Headset,
    title: 'Support & Maintenance',
    description: 'Keep systems running smoothly with proactive monitoring, troubleshooting, and ongoing support.',
    capabilities: ['Monitoring', 'Troubleshooting', 'Upgrades'],
  },
  {
    icon: Blocks,
    title: 'System Integration',
    description: 'Connect disparate systems into a unified environment that improves visibility and workflow.',
    capabilities: ['Interoperability', 'API', 'Workflow'],
  },
];
---

<section aria-labelledby="solutions-title" class="bg-white">
  <div class="mx-auto max-w-7xl px-8 py-section">
    <header class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="font-semibold text-brand-900 lg:max-w-xl">
        <p class="text-2xl uppercase">{eyebrow}</p>
        <h2 id="solutions-title" class="mt-3.5 text-4xl/tight sm:text-display">{title}</h2>
      </div>
      <p class="max-w-prose text-xl/[1.65] text-copy lg:max-w-95 lg:text-lead">{description}</p>
    </header>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {solutions.map((solution) => <SolutionCard {...solution} />)}
    </ul>
  </div>
</section>
