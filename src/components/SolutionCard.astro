---
import type { AstroComponent } from '@lucide/astro';

interface Props {
  icon: AstroComponent;
  title: string;
  description: string;
  capabilities: string[];
}

const { icon: Icon, title, description, capabilities } = Astro.props;
---

<li class="flex flex-col gap-5 rounded-lg border border-brand-100 bg-white p-7.5">
  <div class="flex size-12 items-center justify-center rounded-sm bg-brand-75 text-brand-900">
    <Icon size={26} />
  </div>

  <div class="flex flex-col gap-3">
    <h3 class="text-title font-semibold text-brand-900">{title}</h3>
    <p class="text-small text-copy">{description}</p>
  </div>

  <ul class="mt-auto flex flex-wrap gap-x-1.5 border-t border-brand-100 pt-4 text-caption text-muted">
    {
      capabilities.map((item, i) => (
        <li class="flex gap-1.5">
          {item}
          {i < capabilities.length - 1 && <span aria-hidden="true">·</span>}
        </li>
      ))
    }
  </ul>
</li>
